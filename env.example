# 双市场温度计 - 环境变量配置模板
# 复制此文件为 .env 并填入真实的API密钥

# ============================================
# FRED API 配置
# ============================================
# 获取方式：访问 https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ============================================
# 代理设置（可选）
# ============================================
# 如果需要通过代理访问网络数据源，请取消注释并配置
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ============================================
# 数据库设置
# ============================================
# 数据库文件路径（相对于项目根目录）
DATABASE_PATH=market_thermo.db

# ============================================
# 日志设置
# ============================================
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=market_thermo.log

